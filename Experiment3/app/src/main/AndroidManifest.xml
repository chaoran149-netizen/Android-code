<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 隐式调用系统相机需要用到的查询声明（Android 11+ 包可见性） -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Experiment3">

        <!-- 主 Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 二级 Activity 1：接收正向传参 -->
        <activity
            android:name=".SecondActivity"
            android:exported="false"
            android:label="@string/second_title" />

        <!-- 二级 Activity 2：输入并返回数据 -->
        <activity
            android:name=".ThirdActivity"
            android:exported="false"
            android:label="@string/third_title" />

        <!-- 二级 Activity 3：隐式调用相机拍照 -->
        <activity
            android:name=".FourthActivity"
            android:exported="false"
            android:label="@string/fourth_title" />

        <!-- 二级 Activity 4：秒表 -->
        <activity
            android:name=".FifthActivity"
            android:exported="false"
            android:label="@string/fifth_title" />

        <!-- FileProvider：给系统相机一个可写的内容 URI，用于保存照片 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
