<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Heading" android:text="@string/edit_title" />
<ImageView android:id="@+id/avatar" android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp" android:src="@drawable/ic_avatar" android:scaleType="centerCrop" android:contentDescription="@string/avatar_description"/>
<Button android:id="@+id/take_avatar" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SecondaryButton" android:text="@string/take_avatar" />
<EditText android:id="@+id/edit_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/name_label" android:inputType="textPersonName" android:maxLength="40" android:minHeight="54dp" android:singleLine="true" android:importantForAutofill="no" />
<EditText android:id="@+id/edit_student" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/student_label" android:inputType="text" android:maxLength="32" android:minHeight="54dp" android:singleLine="true" android:importantForAutofill="no" />
<EditText android:id="@+id/edit_phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/phone_label" android:inputType="phone" android:maxLength="24" android:minHeight="54dp" android:singleLine="true" android:importantForAutofill="no" />
<EditText android:id="@+id/edit_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/email_label" android:inputType="textEmailAddress" android:maxLength="100" android:minHeight="54dp" android:singleLine="true" android:importantForAutofill="no" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Row" android:text="@string/gender_label" />
<RadioGroup android:id="@+id/gender_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><RadioButton android:id="@+id/gender_male" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/male"/><RadioButton android:id="@+id/gender_female" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/female"/><RadioButton android:id="@+id/gender_unspecified" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/unspecified"/></RadioGroup>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Row" android:text="@string/hobbies_label" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><CheckBox android:id="@+id/hobby_travel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/hobby_travel" android:textSize="14sp" android:minWidth="0dp" android:padding="0dp"/><CheckBox android:id="@+id/hobby_reading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/hobby_reading" android:textSize="14sp" android:minWidth="0dp" android:padding="0dp"/><CheckBox android:id="@+id/hobby_game" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/hobby_game" android:textSize="14sp" android:minWidth="0dp" android:padding="0dp"/><CheckBox android:id="@+id/hobby_shopping" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="@string/hobby_shopping" android:textSize="14sp" android:minWidth="0dp" android:padding="0dp"/></LinearLayout>
<Button android:id="@+id/save_profile" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/PrimaryButton" android:text="@string/save" />
<Button android:id="@+id/cancel_profile" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/SecondaryButton" android:text="@string/cancel" />
</LinearLayout></ScrollView>
