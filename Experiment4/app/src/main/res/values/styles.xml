<resources>
<style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
<item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/green</item><item name="android:windowBackground">@color/paper</item><item name="android:statusBarColor">@color/paper</item><item name="android:windowLightStatusBar">true</item><item name="android:navigationBarColor">@color/paper</item><item name="android:colorControlHighlight">@color/green_light</item></style>
<style name="Heading"><item name="android:textSize">28sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/ink</item><item name="android:layout_marginBottom">8dp</item></style>
<style name="Body"><item name="android:textSize">16sp</item><item name="android:textColor">@color/muted</item><item name="android:layout_marginBottom">12dp</item></style>
<style name="Row"><item name="android:textSize">17sp</item><item name="android:textColor">@color/ink</item><item name="android:paddingTop">9dp</item><item name="android:paddingBottom">9dp</item></style>
<style name="PrimaryButton" parent="android:style/Widget.Material.Button"><item name="android:background">@drawable/button_primary</item><item name="android:backgroundTint">@null</item><item name="android:textColor">@color/white</item><item name="android:textAllCaps">false</item><item name="android:minHeight">48dp</item><item name="android:layout_marginTop">10dp</item><item name="android:padding">12dp</item></style>
<style name="SecondaryButton" parent="PrimaryButton"><item name="android:background">@drawable/button_secondary</item><item name="android:textColor">@color/green</item></style>
</resources>
